# Copier ce fichier en .env.local (dans apps/web/, jamais commité) et remplir les valeurs réelles.
# Next.js charge .env.local depuis le dossier de l'app (apps/web), pas depuis la racine du monorepo.

# --- Supabase (projet "3 Sauces Project") ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Twilio (OTP site UNIQUEMENT — vérification identité à la commande en ligne) ---
# Plus aucun SMS marketing/fidélité dans le système : Twilio Verify n'a pas
# forcément besoin d'un numéro acheté, il peut gérer l'envoi lui-même via le
# Verify Service (à confirmer selon la couverture pour +262).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=

# --- Resend (email transactionnel : récompense fidélité, rappel J-7 expiration) ---
RESEND_API_KEY=

# --- Anthropic (OCR factures - Module 4) ---
ANTHROPIC_API_KEY=

# --- Stripe (paiement site 3sauces.fr uniquement) ---
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# --- SumUp (paiement caisse physique uniquement) ---
SUMUP_API_KEY=
SUMUP_MERCHANT_CODE=

# --- Auth interne (signature des sessions PIN employé/livreur + patron) ---
AUTH_SECRET=
